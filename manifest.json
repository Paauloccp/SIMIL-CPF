{
  "manifest_version": 3,
  "name": "SIMIL CAIXA - Preencher CPF",
  "version": "1.0.5",
  "description": "Preenche CPFs no SIMIL da CAIXA.",
  "content_scripts": [
    {
      "matches": [
        "https://simil.caixa.gov.br/*",
        "https://www.simil.caixa.gov.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}