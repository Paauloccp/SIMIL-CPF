{
  "manifest_version": 3,
  "name": "SIMIL CAIXA - Utilidades",
  "version": "1.1.1",
  "description": "Preenche CPFs e replica dados recorrentes no SIMIL da CAIXA.",
  "content_scripts": [
    {
      "matches": [
        "https://simil.caixa.gov.br/*",
        "https://www.simil.caixa.gov.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
